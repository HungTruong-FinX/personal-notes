# ---------- profile ----------
# Use "sit" like UAT, not "local": application-local.yml hard-codes arrangement-activity-enabled=true and localhost:19092
SPRING_PROFILES_ACTIVE=sit
CBI_REST_PORT=7087
MANAGEMENT_SERVER_PORT=9087
ROOT_LOG_LEVEL=INFO
CBI_LOG_LEVEL=DEBUG

# ---------- UAT Kafka (MSK, plaintext 9092, needs VPN) ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Your own group, starting at the newest offset: never join the UAT pods' group, never replay UAT history
POSTING_KAFKA_GROUP=cbi-posting-event-service-local-hung
SPRING_KAFKA_CONSUMER_AUTOOFFSETRESET=latest

# Input topic: a private one, so only YOUR test message is fanned out (see note 2)
KAFKA_POSTING_BATCH_PROCESSING_TOPIC=cbi.postings.posting_instruction_batch.processing-event
# Fallback if MSK won't auto-create that topic:
# KAFKA_POSTING_BATCH_PROCESSING_TOPIC=cbi.postings.posting_instruction_batch.processing-event

# Output topics: UAT's real ones (defaults, listed so you know where to look)
POSTING_EVENT_OUTBOUND_TOPIC=cbi.api.v1.postings.posting_instruction_batch.created
INTERBANK_TRANSFER_RESPONSE_TOPIC=cbi.integration.postings_api.interbank_transfer.response
ACCOUNT_BALANCE_OUTBOUND_TOPIC=cbi.account_balance.events.v1

# ---------- what runs ----------
CBI_POSTING_EVENT_ENABLED=true
CBI_POSTING_EVENT_BATCH_ENABLED=true
KAFKA_TM_FORWARD_ENABLED=false
CBI_POSTING_EVENT_T24_ARRANGEMENT_ACTIVITY_ENABLED=false
CBI_POSTING_EVENT_T24_FUNDS_TRANSFER_ENABLED=false
CBI_POSTING_EVENT_T24_CONTRACT_BALANCE_ENABLED=false
CBI_POSTING_EVENT_T24_JMS_ENABLED=false
T24_JMS_ACTIVEMQ_ENABLED=false
T24_JMS_ARTEMIS_ENABLED=false

# ---------- balance lookup for event ④ (UAT account-integration through the ingress) ----------
CBI_ACCOUNT_INTEGRATION_URL=https://core-integration.uat.galaxyfinx.in/api/cbi-account-integration-service

# ---------- Redis: local dedup store (your deploy/local compose) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL_ENABLED=false
POSTING_EVENT_DEDUP_KEY_PREFIX=local-hung-cbi:posting-event:dedup:
POSTING_EVENT_DEDUP_TTL=1d
# UAT Redis instead (VPC-only, password in common-secrets → redis-password):
# REDIS_HOST=master.non-prod-uat-replication-group.ie5tvm.apse1.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_SSL_ENABLED=true
# REDIS_PASSWORD=<from secret>