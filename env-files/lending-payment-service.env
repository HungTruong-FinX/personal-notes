SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8082
MANAGEMENT_SERVER_PORT=9012
PLATFORM_BOOT_TRANSACTION_MANAGEMENT_PLATFORM_ENABLED=true
PLATFORM_BOOT_TRANSACTION_POSTING_PLATFORM_ENABLED=true
# SPRING_REST_CLIENT_CONFIG_PLATFORM_TRANSATION_MANAGEMENT_CLIENT_URL=https://ingress-int.dev.vikkibank.io/api/transaction-service
SPRING_REST_CLIENT_CONFIG_PLATFORM_TRANSATION_MANAGEMENT_CLIENT_URL=http://localhost:8085/api/transaction-service
# SPRING_REST_CLIENT_CONFIG_PLATFORM_TRANSACTION_POSTING_CLIENT_URL=https://ingress-int.dev.vikkibank.io/api/payment-execution
SPRING_REST_CLIENT_CONFIG_PLATFORM_TRANSACTION_POSTING_CLIENT_URL=https://wiremock.nonprod.vikkibank.io/api/payment-execution
LOAN_MANAGEMENT_SERVICE_URL=https://ingress-int.dev.vikkibank.io/api/loan-management
SPRING_REST_CLIENT_CONFIG_PLATFORM_ACCOUNT_CLIENT_URL=https://ingress-int.dev.vikkibank.io/api/account-service
SPRING_REST_CLIENT_CONFIG_PLATFORM_BRANCH_CLIENT_URL=https://ingress-int.dev.vikkibank.io/api/branch-service
SPRING_REST_CLIENT_CONFIG_PLATFORM_CUSTOMER_CLIENT_URL=https://ingress-int.dev.vikkibank.io/api/party-service
SPRING_REST_CLIENT_CONFIG_PLATFORM_PRODUCT_CLIENT_URL=https://ingress-int.dev.vikkibank.io/api/product-management
# SPRING_REST_CLIENT_CONFIG_TRANSACTION_CLIENT_URL=https://ingress-int.dev.vikkibank.io/api/transaction-service
SPRING_REST_CLIENT_CONFIG_TRANSACTION_CLIENT_URL=http://localhost:8085/api/transaction-service
# SPRING_REST_CLIENT_CONFIG_PARTNER_INTERGRATION_CLIENT_URL=https://ingress-int.dev.vikkibank.io/api/partner-integration
SPRING_REST_CLIENT_CONFIG_PARTNER_INTERGRATION_CLIENT_URL=https://wiremock.nonprod.vikkibank.io/api/partner-integration
LENDING_SDK_ORCHESTRATION_REST_CLIENT_ORCHESTRATION_CLIENT_URL=http://localhost:8044/api/lending-orchestration
SPRING_REST_CLIENT_CONFIG_PLATFORM_ACCOUNT_CLIENT_LOGGER_LEVEL=FULL
SPRING_REST_CLIENT_CONFIG_PLATFORM_BRANCH_CLIENT_LOGGER_LEVEL=FULL
SPRING_REST_CLIENT_CONFIG_PLATFORM_CUSTOMER_CLIENT_LOGGER_LEVEL=FULL
SPRING_REST_CLIENT_CONFIG_PLATFORM_TRANSATION_MANAGEMENT_CLIENT_LOGGER_LEVEL=FULL
SPRING_REST_CLIENT_CONFIG_PLATFORM_TRANSACTION_POSTING_CLIENT_LOGGER_LEVEL=FULL
SPRING_REST_CLIENT_CONFIG_PLATFORM_PRODUCT_CLIENT_LOGGER_LEVEL=FULL
spring.application.name=lending-payment
KAFKA_PROPERTIES_BOOTSTRAP_SERVERS=http://localhost:9092
FCC_ADHOC_ENABLED=true
SPRING_REST_CLIENT_CONFIG_PARTNER_INTERGRATION_CLIENT_LOGGING_ENABLED=true
FCC_DISBURSEMENT_WORKFLOW_ENABLED=true
KAFKA_PLAINTEXT_SERVERS=http://localhost:9092
KAFKA_PRODUCER_PAYMENT_INFORM_TOPIC=local.payment-batches.payment.inform.events
FCC_DISBURSEMENT_COMPLETION_STATUSES=SUCCESS,FAILURE,TIMEOUT,SCHEDULED,PROCESSING