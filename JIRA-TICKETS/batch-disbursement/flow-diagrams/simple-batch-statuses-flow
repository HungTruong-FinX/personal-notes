@startuml
title Transaction Batch Status Flow
skinparam defaultTextAlignment center
start
:Batch created;
:IMPORT_IN_PROCESS;
if (Header validation passed?) then (No)
    :IMPORT_VALIDATION_FAILED;
    stop
else (Yes)
endif
if (Import file records successfully?) then (No)
    :IMPORT_FAILED;
    stop
else (Yes)
    :Continue import validation;
endif
:VALIDATION_STARTED;
if (All imported records pass import validation?) then (No)
    :IMPORT_VALIDATION_FAILED;
    stop
else (Yes)
    :IMPORT_COMPLETED;
endif
:Create real transactions from valid records;
:VALIDATION_STARTED;
if (Any business validation failed?) then (Yes)
    :VALIDATION_FAILED;
    stop
else (No)
    :VALIDATION_COMPLETED;
    stop
endif
@enduml